# ─── Supabase (무료 티어) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 서버리스 + Postgres 는 커넥션 폭증 방지를 위해 Supavisor 풀러(포트 6543, ?pgbouncer=true) 사용 권장.
DATABASE_URL=                # 예: postgresql://...@...pooler.supabase.com:6543/postgres?pgbouncer=true

# ─── 레이트리밋 분산(선택) — 미설정 시 인메모리 폴백 ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── 해시 전용 키(선택, 미설정 시 ENCRYPTION_KEY 에서 파생) ───
HASH_KEY=

# 사이트 절대 URL (sitemap/OG 용)
NEXT_PUBLIC_SITE_URL=

# ─── 암호화 (AES-256-GCM). 32바이트 base64 키 ───
ENCRYPTION_KEY=

# ─── 피처 플래그 (Phase 1 기본값) ───
# Mode A(세액공제 기부) UI 게이팅은 클라이언트에서도 읽어야 하므로 NEXT_PUBLIC_ 사용.
# 미리보기: NEXT_PUBLIC_FEATURE_MODE_A=1 로 설정. 실제 런칭은 공익법인 설립·기부금품모집 등록 후.
NEXT_PUBLIC_FEATURE_MODE_A=false
NEXT_PUBLIC_FEATURE_TAX_RECEIPT=false
# 서버 전용 enforcement (선택)
FEATURE_MODE_A=false
FEATURE_TAX_RECEIPT=false
FEATURE_REAL_PAYMENT=false
FEATURE_REAL_IDENTITY=false

# ─── 수수료 정책 (선택, 미설정 시 코드 기본값) ───
FEE_PLATFORM_RATE_B=0.05
FEE_PLATFORM_RATE_A=0.05
FEE_PG_RATE=0.018
FEE_PG_FIXED=0

# ─── 소셜 로그인 (Supabase Auth 콘솔에도 설정 필요) ───
# Google / Apple 은 Supabase 기본 지원. Kakao/Naver 는 커스텀 OIDC.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오톡 공유(JavaScript 키) — 미설정 시 공유 시트에서 카카오 버튼은 '링크 복사'로 폴백
NEXT_PUBLIC_KAKAO_JS_KEY=

# ─── PG (토스페이먼츠) — 실연동 시 ───
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=

# ─── 본인확인 (NICE 디지털 본인확인 / 체크플러스) — 실연동 시 ───
# NICE API 콘솔(developers.nice.co.kr)에서 발급. 활성화하려면 NEXT_PUBLIC_FEATURE_REAL_IDENTITY=1
NEXT_PUBLIC_FEATURE_REAL_IDENTITY=false
FEATURE_REAL_IDENTITY=false
NICE_CLIENT_ID=
NICE_CLIENT_SECRET=
NICE_PRODUCT_ID=
# 본인확인 결과 콜백 절대 URL (미설정 시 요청 origin 기준 자동)
NICE_RETURN_URL=
